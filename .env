# ====================================================================
# DisasterSync AI - Secure Gmail SMTP Email Configuration (.env)
# Store this file in the project root. Never commit passwords to Git!
# Add .env to .gitignore immediately!
# ====================================================================

# Enable / Disable automated email notifications (true / false)
EMAIL_NOTIFICATIONS_ENABLED=true

# Gmail SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Gmail Sender Account
EMAIL_ADDRESS=mrudhulakesamreddy6@gmail.com
GMAIL_USER=mrudhulakesamreddy6@gmail.com
SMTP_USER=mrudhulakesamreddy6@gmail.com

# Gmail App Password (16-character, generated from Google Account)
EMAIL_PASSWORD=jvro xufj cnke xafs
GMAIL_APP_PASSWORD=jvro xufj cnke xafs
SMTP_PASSWORD=jvro xufj cnke xafs

# Registered Emergency Response Officer Email Addresses (comma-separated)
# Alerts will be sent to these addresses on new incidents and status changes
OFFICER_EMAILS=mrudhulakesamreddy6@gmail.com
