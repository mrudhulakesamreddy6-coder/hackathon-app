# ====================================================================
# DisasterSync AI - Secure SMTP Email Configuration (.env)
# Store this file in the project root. Never commit real passwords
# or API keys to public repositories (GitHub, GitLab, etc.)
# ====================================================================

# ====================================================================
# 📧 GMAIL SETUP GUIDE (Telugu / English)
# ====================================================================
#
# Step 1: 2-Step Verification enable cheyyandi
#   Mee Gmail account lo 2-Step Verification enable cheyyali.
#   👉 https://myaccount.google.com/security
#
# Step 2: App Passwords open cheyyandi
#   Security page lo "App Passwords" option select cheyyandi.
#   👉 https://myaccount.google.com/apppasswords
#
# Step 3: App Password generate cheyyandi
#   - "Select app" → "Mail" select cheyyandi
#   - "Select device" → "Windows Computer" (or your device) select cheyyandi
#   - "Generate" button click cheyyandi
#   - Google generate chesina 16-character password ni copy cheyyandi
#
# Step 4: Below fields lo securely store cheyyandi
#   (Example only – actual password kaadu, real password use cheyyandi)
#
#   GMAIL_USER=yourgmail@gmail.com
#   GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   ← 16-character App Password
#
# ⚠️  WARNING: Actual password ni ikkada share cheyyakandi!
#              Real credentials ni GitHub/GitLab lo commit cheyyakandi!
#              .env file ni .gitignore lo add cheyyandi.
# ====================================================================

# Enable / Disable automated email notifications (true / false)
EMAIL_NOTIFICATIONS_ENABLED=true

# SMTP Server Host (Default: Gmail)
# For Gmail: smtp.gmail.com
# For Outlook / Office 365: smtp.office365.com
# For SendGrid: smtp.sendgrid.net
SMTP_SERVER=smtp.gmail.com

# SMTP Server Port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Use STARTTLS Encryption (true / false)
SMTP_USE_TLS=true

# ---- Gmail Credentials (Primary Aliases) ----
# Mee Gmail address ikkada enter cheyyandi (Example only – actual kaadu)
GMAIL_USER=yourgmail@gmail.com

# Google generate chesina 16-character App Password ikkada enter cheyyandi
# (Example only – actual password kaadu)
GMAIL_APP_PASSWORD=your_generated_app_password

# ---- Alternative / Legacy SMTP Aliases (Optional) ----
# Same values as above — either pair works
SMTP_USER=
SMTP_PASSWORD=

# Authorized Emergency Response Officer Email Addresses (comma-separated)
# Dispatches are automatically routed to these inboxes upon new reports & status changes
OFFICER_EMAILS=officer.emergency@disastersync.ai, commander.police@disastersync.ai, fire.rescue@disastersync.ai
